# =============================================================================
# CheaterFinder Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: Optional integrations stay disabled while their values are placeholders.
# Stripe billing fails closed (no fake checkout/cancellation); Apify and Resend
# use their own documented fallback behaviour.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cheaterfinder:your_password@localhost:5432/cheaterfinder_ai

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional. Defaults to redis://localhost:6379 if not set.
REDIS_URL=redis://localhost:6379

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=generate_a_random_64_char_hex_string_here
# Generate base64 32-byte keys with:
#   openssl rand -base64 32
# Required in production. Use different values for key separation.
SESSION_DATA_KEY=generate_a_random_base64_32_byte_key_here
BOT_CRED_KEY=generate_a_different_random_base64_32_byte_key_here

# ── Stripe (Billing) ─────────────────────────────────────────────────────────
# Create recurring monthly Starter/Standard/Pro Products + Prices in the SAME
# Stripe mode as the secret key (test keys with test prices; live with live).
STRIPE_SECRET_KEY=sk_test_your_key_here
# Required by the pricing setup/verification scripts to confirm the account.
STRIPE_EXPECTED_ACCOUNT_ID=
# Hosted Checkout does not require this in the browser today, but keep the
# matching publishable key available for future Stripe Elements use.
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Webhook signing secret — REQUIRED for billing to work in any deployed env.
# Get the REAL value from the Stripe dashboard:
#   Developers → Webhooks → (your endpoint, e.g.
#   https://yourdomain.com/api/webhooks/stripe) → "Signing secret".
# Real values always start with "whsec_". For local testing, run
#   stripe listen --forward-to localhost:5000/api/webhooks/stripe
# and use the whsec_ value it prints.
# Subscribe the deployed endpoint to at least:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.paid
#   invoice.payment_failed
# SECURITY: if this is missing or left as a placeholder, the webhook endpoint
# responds 503 and processes NOTHING (fail-closed). Do NOT ship a placeholder.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_STARTER_PRICE_ID=price_starter_monthly_id
STRIPE_STANDARD_PRICE_ID=price_standard_monthly_id
STRIPE_PRO_PRICE_ID=price_pro_monthly_id
# New eligible trials only. Keep disabled until sandbox Checkout, recurring
# collection, credit and the selected cancellation policy have been verified.
STRIPE_TRIAL_ADVANCE_ENABLED=false
# Operator configuration tool only: required account identity for --live mode.
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_TRIAL_ADVANCE_PRICE_ID=
# Select exactly refund_during_trial OR retain_credit after setting the policy.
STRIPE_TRIAL_CANCELLATION_POLICY=
# Dedicated immediate card/wallet configuration; delayed methods must be off.
STRIPE_TRIAL_PAYMENT_METHOD_CONFIG_ID=
# Required for refund_during_trial: cancellation enabled with mode=immediately.
STRIPE_TRIAL_REFUND_PORTAL_CONFIG_ID=
# NEW founders coupons restricted to recurring products, excluding the advance.
# Never replace or edit discounts already held by existing subscriptions.
STRIPE_TRIAL_FOUNDERS_COUPON_STARTER=
STRIPE_TRIAL_FOUNDERS_COUPON_STANDARD=
STRIPE_TRIAL_FOUNDERS_COUPON_PRO=
# Must match the coupon ID created by server/scripts/setup-rescue-coupon.ts in this Stripe mode.
STRIPE_RESCUE_COUPON_ID=TRIAL_RESCUE_50
# Keep these only while legacy weekly/monthly subscribers still exist. They
# are not offered to new customers, but let webhooks recognize the old plan.
STRIPE_WEEKLY_PRICE_ID=price_legacy_weekly_id
STRIPE_MONTHLY_PRICE_ID=price_legacy_monthly_id
# DANGEROUS — local development only. When set to "true" AND NODE_ENV is not
# "production", the Stripe webhook accepts UNSIGNED payloads (no signature
# verification). Anyone who can reach the endpoint can forge billing events.
# Never enable this on a server reachable from the internet. Default: off.
# STRIPE_WEBHOOK_ALLOW_UNVERIFIED=false

# ── Apify (Instagram Scraping) ───────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_your_token_here

# ── Resend (Transactional Email) ─────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here

# ── Email ─────────────────────────────────────────────────────────────────────
# Optional. Defaults to notifications@cheaterfinder.com
EMAIL_FROM=notifications@cheaterfinder.com

# ── Application URL ──────────────────────────────────────────────────────────
# Used for Stripe redirect URLs. Defaults to http://localhost:5000
APP_URL=http://localhost:5000

# ── Optional browser product analytics ──────────────────────────────────────
# Public PostHog PROJECT token (phc_), never a personal/API administration key.
# Vite's root is client/: set this in client/.env.production.local or export it
# in the production build environment. Empty means disabled; development is off.
# Events use https://us.i.posthog.com only, after a visitor explicitly opts in.
# Rebuild the frontend after changing the token; no DB/worker changes required.
VITE_POSTHOG_KEY=

# ── HTTPS ─────────────────────────────────────────────────────────────────────
# Set to "true" when SSL is configured to enable secure session cookies
HTTPS_ENABLED=false

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Local Python automation service ─────────────────────────────────────────
# The FastAPI process MUST stay on 127.0.0.1. Express calls it via Undici; it
# owns Instagram browser sessions and fingerprinted HTTP clients. Use the same
# high-entropy value in the Python process and here.
AUTOMATION_API_URL=http://127.0.0.1:8787
AUTOMATION_API_TOKEN=generate_a_different_random_64_char_hex_string_here

# Opt-in local Instagram request transcript. Records method, URL, sanitized
# headers, status, and a bounded response body at a 0600 file path. Cookies,
# CSRF/claim tokens, passwords, and proxy credentials are always redacted.
AUTOMATION_TRACE_REQUESTS=false
# AUTOMATION_TRACE_LOG_PATH=automation/logs/instagram-trace.log
AUTOMATION_TRACE_BODY_MAX_BYTES=65536
# Rotates at this size, retaining one `.1` previous file. Values cap at 100 MiB.
AUTOMATION_TRACE_FILE_MAX_BYTES=10485760

# Image galleries and roster pages can legitimately request hundreds of
# avatars in one visit. Defaults: 2000 images / 5 min / user, 60 videos.
IMG_PROXY_RATE_MAX=2000
IMG_PROXY_VIDEO_RATE_MAX=60

# ── Observability (Wave 2) ───────────────────────────────────────────────────
# Optional paid fallback for public follower/following lists that every local
# Instagram observer session receives as `special_empty_state`.
APIFY_GRAPH_FALLBACK_ENABLED=false
APIFY_GRAPH_MAX_ITEMS=2000
APIFY_GRAPH_MAX_USD_PER_RUN=10
# Paid fallbacks are complete exports; do not buy the same roster every normal
# profile refresh. Minimum 1 hour, maximum 7 days, default 24 hours.
APIFY_GRAPH_REFRESH_SEC=86400
# Reuse one successful public export across duplicate tracking rows.
APIFY_GRAPH_RESULT_TTL_MS=900000
# Optional emergency graph fallback. When enabled, an independently required
# roster read (new/incomplete/changed/overdue) may use paid Apify only when the
# whole roster fits under APIFY_GRAPH_MAX_ITEMS and the local provider is down.
APIFY_GRAPH_PROVIDER_OUTAGE_FALLBACK_ENABLED=false

# Liked-post evidence is sampled from a rotating window of accounts the target
# follows. Keep the per-run request budget bounded; the persistent cursor gives
# the rest of the roster a turn on later cycles.
LIKE_EVIDENCE_FOLLOWING_SCAN_LIMIT=5
LIKE_EVIDENCE_POSTS_PER_OWNER=2
ROSTER_RESTRICTED_RETRY_SEC=43200

# Optional same-viewer transport recovery. Enable only after verifying the
# chosen lane with the existing account, session and proxy configuration.
# All private access checks and finite daily budgets remain enforced.
PINNED_WEB_MOBILE_READS_ENABLED=false
IG_MEDIA_BROWSER_FALLBACK_ENABLED=false
IG_NATIVE_PUBLIC_READS_ENABLED=false
IG_NATIVE_PUBLIC_TARGETS=

# Preserve the age-based request ramp by default. Disabling it uses finite
# read caps; it does not disable follow limits, cooldowns or auth checks.
BOT_READ_WARMUP_ENABLED=true

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Residential Proxies ──────────────────────────────────────────────────────
# Optional authenticated range. When set, this takes priority over
# SMARTPROXY_API_URL. Ports are normalized into host:port:username:password
# and still pass the Instagram health probe before assignment.
# DataImpulse :823 and ports 10000-20000 are short-lived rotating/sticky lanes
# (about 30 minutes by default), suitable only for public or transient traffic.
# They are deliberately rejected as fixed account-session proxies.
# For a single rotating DataImpulse gateway, prefer the atomic credential form;
# it takes priority over STATIC_PROXY_* and avoids partial credential rotation.
# DATAIMPULSE_PROXY_URL=username:password@gw.dataimpulse.com:823
# Reuse that credential across the documented port-based sticky range for
# public-read capacity. Both values are required when either is set.
# DATAIMPULSE_PROXY_PORT_START=10000
# DATAIMPULSE_PROXY_PORT_END=19998
# Optional operator-only sticky credential used to stage reserve-account
# sessions. The activation script remains gated by --allow-short-lived-proxy.
# DATAIMPULSE_ACCOUNT_PROXY_URL=username:password@gw.dataimpulse.com:10000
# DATAIMPULSE_ACCOUNT_STICKY_TTL_MINUTES=120
# Keep false in production. The override is limited to a supervised,
# non-production bootstrap with no existing session; authenticated session
# reuse through a short-lived lane remains blocked even when it is true.
# BOT_ALLOW_SHORT_LIVED_ACCOUNT_PROXY=false
# STATIC_PROXY_HOST=gw.example.com
# STATIC_PROXY_PORT_START=10000
# STATIC_PROXY_PORT_END=19998
# STATIC_PROXY_USERNAME=your_proxy_username
# STATIC_PROXY_PASSWORD=your_proxy_password
# Avoid repeating a full endpoint probe wave for every account while the
# provider is rejecting all lanes. A successful probe closes it immediately.
PROXY_PROVIDER_UNAVAILABLE_COOLDOWN_MS=300000

# ── Retention (Wave 2) ───────────────────────────────────────────────────────
# How many days of event data to keep. The daily retention worker prunes
# like_events, follow_events, unfollow_events, and profile_snapshots older
# than this cutoff. Range 1-3650. Default 90.
RETENTION_DAYS_EVENTS=90

# ── Mobile app ───────────────────────────────────────────────────────────────
# Custom URL scheme the React Native app registers (app.json expo.scheme).
MOBILE_APP_SCHEME=cheaterfinder

# Universal Links / Android App Links. Both are OPTIONAL — the association
# endpoints return 404 until set, which is correct: a malformed association file
# is worse than none (iOS caches it, Android stops verifying).
#   APPLE_APP_ID   = "<AppleTeamID>.<iosBundleIdentifier>"  e.g. ABCDE12345.com.cheaterfinder.app
#   ANDROID_SHA256 = signing-cert SHA-256 from `eas credentials`, colon-separated hex
#   ANDROID_PACKAGE defaults to com.cheaterfinder.app
APPLE_APP_ID=
ANDROID_SHA256=
ANDROID_PACKAGE=com.cheaterfinder.app
